  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
    <button class="lightbox-close" id="lb-close">✕</button>
    <button class="lightbox-nav lightbox-prev" id="lb-prev">‹</button>
    <img class="lightbox-img" id="lb-img" src="" alt="" />
    <button class="lightbox-nav lightbox-next" id="lb-next">›</button>
    <div class="lightbox-counter" id="lb-counter"></div>
  </div>

  <script>
    // Gate
    const gate = document.getElementById('gate')!;
    const form = document.getElementById('gate-form')!;
    const input = document.getElementById('pw-input') as HTMLInputElement;
    const error = document.getElementById('gate-error')!;
    if (sessionStorage.getItem('schulze_access') === '1') gate.classList.add('hidden');
    form.addEventListener('submit', e => {
      e.preventDefault();
      if (input.value.toLowerCase() === 'schulze') {
        sessionStorage.setItem('schulze_access','1'); gate.classList.add('hidden'); error.classList.remove('visible');
      } else { error.classList.add('visible'); input.value=''; input.focus(); }
    });

    // Hamburger
    const hbg = document.getElementById('hamburger')!;
    const mnav = document.getElementById('mobile-nav')!;
    hbg.addEventListener('click', () => { hbg.classList.toggle('open'); mnav.classList.toggle('open'); });
    mnav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { hbg.classList.remove('open'); mnav.classList.remove('open'); }));

    // Scroll reveal
    const revealEls = document.querySelectorAll('.reveal');
    const ro = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('in'); ro.unobserve(e.target); } });
    }, { threshold: 0.12 });
    revealEls.forEach(el => ro.observe(el));

    // Variant nav highlight
    const sections = ['stil-a','stil-b','stil-c','stil-d','stil-e'];
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.variant-nav a');
    const so = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          navLinks.forEach(a => { a.style.color=''; a.style.borderBottomColor=''; });
          const a = document.querySelector<HTMLAnchorElement>(`.variant-nav a[href="#${e.target.id}"]`);
          if (a) { a.style.color='var(--cream)'; a.style.borderBottomColor='var(--dark-4)'; }
        }
      });
    }, { threshold: 0.25 });
    sections.forEach(id => { const el = document.getElementById(id); if (el) so.observe(el); });

    // Lightbox
    const lb = document.getElementById('lightbox')!;
    const lbImg = document.getElementById('lb-img') as HTMLImageElement;
    const lbCtr = document.getElementById('lb-counter')!;
    const lbClose = document.getElementById('lb-close')!;
    const lbPrev = document.getElementById('lb-prev')!;
    const lbNext = document.getElementById('lb-next')!;
    const imgs = [...document.querySelectorAll<HTMLImageElement>('[data-lightbox-idx] img')].map(i => ({src:i.src,alt:i.alt}));
    let idx = 0;
    const open = (i: number) => { idx=i; lbImg.src=imgs[i].src; lbImg.alt=imgs[i].alt; lbCtr.textContent=`${i+1} / ${imgs.length}`; lb.classList.add('open'); document.body.style.overflow='hidden'; };
    const close = () => { lb.classList.remove('open'); document.body.style.overflow=''; };
    const prev = () => { idx=(idx-1+imgs.length)%imgs.length; lbImg.src=imgs[idx].src; lbCtr.textContent=`${idx+1} / ${imgs.length}`; };
    const next = () => { idx=(idx+1)%imgs.length; lbImg.src=imgs[idx].src; lbCtr.textContent=`${idx+1} / ${imgs.length}`; };
    document.querySelectorAll('[data-lightbox-idx]').forEach(el => el.addEventListener('click', () => open(parseInt((el as HTMLElement).dataset.lightboxIdx??'0',10))));
    lbClose.addEventListener('click', close);
    lbPrev.addEventListener('click', prev);
    lbNext.addEventListener('click', next);
    lb.addEventListener('click', e => { if (e.target===lb) close(); });
    document.addEventListener('keydown', e => { if (!lb.classList.contains('open')) return; if (e.key==='Escape') close(); if (e.key==='ArrowLeft') prev(); if (e.key==='ArrowRight') next(); });
  </script>

</body>
