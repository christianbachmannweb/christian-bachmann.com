---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import lukasPortrait from '../../assets/holzbau-schulze-bilder/Lukas-bg-removed.png';

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/holzbau-schulze-bilder/foto-*.jpg',
  { eager: true }
);

const photos = Object.entries(photoModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

const featuredPhotos = photos.slice(0, 3);
const galleryPhotos  = photos.slice(3);

const p04 = photos[0];
const p05 = photos[1];
const p06 = photos[2];
const p07 = photos[3];
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bilder – Holzbau Schulze · Webseiten-Konzept</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,300;1,400&family=Big+Shoulders+Display:wght@400;600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    /* ── GATE ── */
    #gate{position:fixed;inset:0;z-index:9999;background:#0f0f0e;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:'Libre Franklin',sans-serif;padding:32px}
    #gate.hidden{display:none}
    .gate-dot{width:8px;height:8px;background:#fffe00;border-radius:50%;margin-bottom:40px}
    .gate-title{font-size:13px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:#6b6b64;margin-bottom:32px}
    .gate-form{display:flex;flex-direction:column;gap:12px;width:100%;max-width:280px}
    .gate-input{background:#1c1c1a;border:1px solid #2a2a27;color:#f0ede4;font-family:'Libre Franklin',sans-serif;font-size:15px;padding:14px 16px;outline:none;transition:border-color .2s}
    .gate-input:focus{border-color:#fffe00}
    .gate-input::placeholder{color:#3a3a36}
    .gate-btn{background:#fffe00;color:#111110;font-family:'Libre Franklin',sans-serif;font-weight:700;font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:14px;border:none;cursor:pointer}
    .gate-error{font-size:12px;color:rgba(255,80,80,.8);text-align:center;display:none}
    .gate-error.visible{display:block}

    /* ── BASE ── */
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --yellow:#fffe00;
      --yellow-dim:rgba(255,254,0,.09);
      --dark:#111110;
      --dark-2:#1a1a18;
      --dark-3:#252522;
      --dark-4:#363632;
      --mid:#6b6b64;
      --light:#c8c8bc;
      --cream:#f0ede4;
      --white:#ffffff;
      --font-display:'Big Shoulders Display',sans-serif;
      --font-body:'Libre Franklin',sans-serif;
    }
    html{scroll-behavior:smooth}
    body{background:var(--dark);color:var(--cream);font-family:var(--font-body);font-size:16px;line-height:1.6;overflow-x:clip}
    .container{max-width:960px;margin:0 auto;padding:0 40px}

    .label{font-family:var(--font-body);font-size:10px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--yellow);margin-bottom:12px}
    h2{font-family:var(--font-display);font-size:clamp(32px,5vw,52px);font-weight:700;line-height:1.05;color:var(--white);margin-bottom:24px;text-transform:uppercase;letter-spacing:.02em}
    p{color:var(--light);max-width:640px}
    p+p{margin-top:12px}

    /* ── HEADER ── */
    header{background:var(--dark-2);border-bottom:2px solid var(--yellow);padding:18px 0;position:sticky;top:0;z-index:100}
    .header-inner{display:flex;align-items:center;justify-content:space-between;max-width:960px;margin:0 auto;padding:0 40px;gap:24px}
    .logo-img{height:38px;width:auto;display:block}
    .header-nav{display:flex;align-items:center;gap:2px}
    .header-nav a{font-family:var(--font-body);font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--mid);text-decoration:none;padding:6px 14px;border:1px solid transparent;transition:color .15s,border-color .15s}
    .header-nav a:hover{color:var(--cream)}
    .header-nav a.active{color:var(--yellow);border-color:rgba(255,254,0,.25)}
    .header-badge{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--dark-4);flex-shrink:0}
    .hamburger{display:none;flex-direction:column;justify-content:center;gap:5px;width:36px;height:36px;background:none;border:none;cursor:pointer;padding:4px;flex-shrink:0}
    .hamburger span{display:block;height:2px;background:var(--cream);transition:transform .25s ease,opacity .2s ease,width .2s ease;transform-origin:center}
    .hamburger span:nth-child(2){width:70%}
    .hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
    .hamburger.open span:nth-child(2){opacity:0;width:100%}
    .hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
    .mobile-nav{display:none;position:absolute;top:100%;left:0;right:0;background:var(--dark-2);border-bottom:2px solid var(--yellow);padding:8px 0 16px;z-index:99}
    .mobile-nav.open{display:block}
    .mobile-nav a{display:block;font-family:var(--font-body);font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--mid);text-decoration:none;padding:14px 40px;border-bottom:1px solid var(--dark-3);transition:color .15s,background .15s}
    .mobile-nav a:last-child{border-bottom:none}
    .mobile-nav a:hover{color:var(--cream);background:var(--dark-3)}
    .mobile-nav a.active{color:var(--yellow)}
    @media(max-width:640px){.header-badge{display:none}.header-nav{display:none}.hamburger{display:flex}}

    /* ── HERO FREIGESTELLT (STIL A) ── */
    .hero-portrait{padding:0;overflow:hidden;background:var(--dark)}
    .hero-portrait-inner{display:grid;grid-template-columns:1fr 1.15fr;align-items:end;min-height:92vh;max-width:960px;margin:0 auto;padding:0 40px;gap:0}
    .hero-portrait-text{padding:100px 56px 80px 0;display:flex;flex-direction:column;justify-content:center}
    .hero-eyebrow{font-size:10px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--yellow);margin-bottom:24px}
    .hero-portrait-title{font-family:var(--font-display);font-size:clamp(44px,7vw,80px);font-weight:900;line-height:.9;text-transform:uppercase;color:var(--white);margin-bottom:32px;letter-spacing:-.01em}
    .hero-portrait-desc{font-size:15px;font-weight:300;color:var(--light);line-height:1.75;margin-bottom:40px;max-width:360px}
    .pill-row{display:flex;flex-wrap:wrap;gap:8px}
    .pill{font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:5px 12px}
    .pill.y{background:var(--yellow-dim);border:1px solid rgba(255,254,0,.3);color:var(--yellow)}
    .pill.g{border:1px solid var(--dark-4);color:var(--mid)}
    .hero-portrait-figure{position:relative;display:flex;align-items:flex-end;justify-content:center;height:92vh;overflow:visible}
    .hero-portrait-figure img{height:108%;max-height:none;width:auto;max-width:none;display:block;object-fit:contain;object-position:bottom center;position:relative;z-index:2}
    .hero-portrait-figure::before{content:'';position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:380px;height:160px;background:radial-gradient(ellipse at center bottom,rgba(255,254,0,.16) 0%,transparent 68%);z-index:1}
    .hero-portrait-name{position:absolute;bottom:48px;right:0;font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--mid);opacity:.35;writing-mode:vertical-rl;transform:rotate(180deg)}
    @media(max-width:768px){.hero-portrait-inner{grid-template-columns:1fr;min-height:auto}.hero-portrait-text{padding:60px 0 28px}.hero-portrait-figure{height:72vw;min-height:340px}}

    /* ── NOTICE ── */
    .notice-banner{padding:14px 40px;background:var(--yellow-dim);border-top:1px solid rgba(255,254,0,.12);border-bottom:1px solid rgba(255,254,0,.12)}
    .notice-inner{max-width:960px;margin:0 auto;display:flex;gap:14px;align-items:flex-start}
    .notice-dot{width:5px;height:5px;background:var(--yellow);border-radius:50%;margin-top:7px;flex-shrink:0}
    .notice-txt{font-size:13px;color:var(--light);line-height:1.6;max-width:none}
    .notice-txt strong{color:var(--yellow);font-weight:600}

    /* ── VARIANT NAV ── */
    .variant-nav{background:var(--dark-2);border-bottom:1px solid var(--dark-3);position:sticky;top:76px;z-index:90;overflow-x:auto}
    .variant-nav-inner{display:flex;align-items:stretch;max-width:960px;margin:0 auto;padding:0 40px}
    .variant-nav-label{font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--dark-4);display:flex;align-items:center;padding-right:20px;margin-right:4px;border-right:1px solid var(--dark-3)}
    .variant-nav a{font-family:var(--font-body);font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--mid);text-decoration:none;padding:13px 18px;border-bottom:2px solid transparent;white-space:nowrap;transition:color .15s,border-color .15s;display:flex;align-items:center;gap:6px}
    .variant-nav a:hover{color:var(--cream)}
    .variant-nav a.rec{color:var(--yellow)}
    .variant-nav a .star{color:var(--yellow)}

    /* Variant header strip — shared */
    .vs{padding:0;border-top:1px solid var(--dark-3)}
    .vs-strip{padding:16px 0;background:var(--dark-2);border-bottom:1px solid var(--dark-3)}
    .vs-strip-inner{max-width:960px;margin:0 auto;padding:0 40px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
    .vs-id{font-family:var(--font-display);font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--mid);display:flex;align-items:center;gap:10px}
    .vs-id strong{font-size:13px;color:var(--white)}
    .vs-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .vs-code{font-family:'Courier New',monospace;font-size:10px;color:var(--mid);background:var(--dark-3);padding:3px 9px;border:1px solid var(--dark-4)}
    .vs-badge{font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:3px 9px}
    .vs-badge.r{background:var(--yellow);color:var(--dark)}
    .vs-badge.a{border:1px solid var(--dark-4);color:var(--mid)}

    /* ════════════════════════════════
       STIL B — STATS-LEISTE UNTEN
    ════════════════════════════════ */
    .ab{background:var(--dark)}
    .ab-grid{display:grid;grid-template-columns:1fr 420px;align-items:stretch;max-width:960px;margin:0 auto;padding:0 40px}
    .ab-text{padding:80px 64px 72px 0;display:flex;flex-direction:column;justify-content:center}
    .ab-title{font-family:var(--font-display);font-size:clamp(52px,7vw,88px);font-weight:900;text-transform:uppercase;line-height:.88;letter-spacing:-.01em;color:var(--white);margin-bottom:28px}
    .ab-title em{font-style:normal;color:var(--yellow)}
    .ab-desc{font-size:15px;line-height:1.75;color:var(--light);margin-bottom:36px;max-width:none;font-weight:300}
    .ab-cta{display:inline-flex;align-items:center;gap:10px;background:var(--yellow);color:var(--dark);font-family:var(--font-body);font-weight:800;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:16px 28px 12px;text-decoration:none;clip-path:polygon(0 8px,50% 0,100% 8px,100% 100%,0 100%);transition:background .2s,clip-path .3s cubic-bezier(.34,1.56,.64,1)}
    .ab-cta:hover{background:#ffff33;clip-path:polygon(0 16px,50% 0,100% 16px,100% 100%,0 100%)}
    .ab-portrait{overflow:hidden;min-height:540px}
    .ab-portrait img{width:100%;height:100%;object-fit:cover;object-position:top center;display:block;filter:brightness(.88) saturate(.85);transition:filter .4s}
    .ab-portrait:hover img{filter:brightness(.95) saturate(1)}
    /* Stats strip */
    .ab-stats{max-width:960px;margin:0 auto;padding:0 40px;display:grid;grid-template-columns:1fr 1fr 1fr;border-top:1px solid var(--dark-3)}
    .ab-stat{padding:36px 0;border-right:1px solid var(--dark-3);padding-right:40px;padding-left:0}
    .ab-stat+.ab-stat{padding-left:40px}
    .ab-stat:last-child{border-right:none}
    .ab-stat-num{font-family:var(--font-display);font-size:clamp(56px,7vw,80px);font-weight:900;color:var(--yellow);line-height:.9;margin-bottom:10px;letter-spacing:-.02em}
    .ab-stat-lbl{font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--mid)}
    .ab-name{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--mid);opacity:.4;margin-top:8px}
    @media(max-width:760px){.ab-grid{grid-template-columns:1fr}.ab-portrait{min-height:320px}.ab-text{padding:60px 0 40px}.ab-stats{grid-template-columns:1fr 1fr}.ab-stat:nth-child(2){border-right:none}.ab-stat:last-child{grid-column:1/-1;border-right:none}}

    /* ════════════════════════════════
       STIL C — WEICHES GROSSES PORTRAIT
    ════════════════════════════════ */
    .ac{position:relative;overflow:hidden;background:var(--dark-2);padding:88px 0}
    .ac::before{content:'ÜBER';position:absolute;font-family:var(--font-display);font-size:clamp(160px,24vw,320px);font-weight:900;color:#fff;opacity:.025;top:50%;left:-20px;transform:translateY(-50%);letter-spacing:-.04em;line-height:1;user-select:none;pointer-events:none;text-transform:uppercase}
    .ac-grid{display:grid;grid-template-columns:400px 1fr;gap:64px;align-items:center;max-width:960px;margin:0 auto;padding:0 40px;position:relative;z-index:1}
    .ac-img{position:relative}
    .ac-img img{width:100%;height:auto;display:block;border-radius:40px;border:2px solid rgba(255,254,0,.18)}
    /* Yellow corner accent (top-right) */
    .ac-img::after{content:'';position:absolute;top:-1px;right:-1px;width:48px;height:48px;border-top:3px solid var(--yellow);border-right:3px solid var(--yellow);border-radius:0 40px 0 0}
    .ac-text{}
    .ac-eyebrow{font-size:10px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--yellow);margin-bottom:18px}
    .ac-title{font-family:var(--font-display);font-size:clamp(40px,5.5vw,70px);font-weight:900;text-transform:uppercase;line-height:.88;color:var(--white);margin-bottom:24px;letter-spacing:-.01em}
    .ac-title em{font-style:normal;color:var(--yellow)}
    .ac-desc{font-size:15px;font-weight:300;color:var(--light);line-height:1.75;margin-bottom:36px;max-width:none}
    .ac-divider{width:40px;height:2px;background:var(--yellow);margin-bottom:28px}
    .ac-bullets{display:flex;flex-direction:column;gap:14px}
    .ac-bullet{display:flex;align-items:flex-start;gap:14px}
    .ac-dot{width:5px;height:5px;border-radius:50%;background:var(--yellow);flex-shrink:0;margin-top:9px}
    .ac-bullet-txt{font-size:14px;color:var(--light);line-height:1.5;max-width:none}
    @media(max-width:700px){.ac-grid{grid-template-columns:1fr;gap:36px}.ac::before{display:none}}

    /* ════════════════════════════════
       STIL D — FULL-BLEED CINEMATIC
    ════════════════════════════════ */
    .ad{position:relative;overflow:hidden;min-height:90vh;display:flex;flex-direction:column;justify-content:flex-end}
    .ad-bg{position:absolute;inset:0;z-index:0}
    .ad-bg img{width:100%;height:100%;object-fit:cover;object-position:top center;display:block}
    /* Layered gradients for depth */
    .ad::before{content:'';position:absolute;inset:0;background:linear-gradient(105deg,rgba(17,17,16,.95) 0%,rgba(17,17,16,.6) 45%,rgba(17,17,16,.2) 100%);z-index:1}
    .ad::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(17,17,16,.98) 0%,rgba(17,17,16,.3) 50%,transparent 100%);z-index:1}
    .ad-content{position:relative;z-index:2;max-width:960px;margin:0 auto;padding:0 40px 72px;width:100%}
    .ad-eyebrow{font-size:10px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--yellow);margin-bottom:20px}
    .ad-title{font-family:var(--font-display);font-size:clamp(64px,11vw,130px);font-weight:900;text-transform:uppercase;line-height:.85;letter-spacing:-.02em;color:var(--white);margin-bottom:0}
    .ad-title em{font-style:normal;color:var(--yellow)}
    .ad-bottom{display:grid;grid-template-columns:1fr auto;gap:60px;align-items:end;margin-top:48px;padding-top:40px;border-top:1px solid rgba(255,255,255,.08)}
    .ad-desc{font-size:16px;font-weight:300;color:var(--light);line-height:1.7;max-width:520px}
    .ad-aside{display:flex;flex-direction:column;gap:0;text-align:right;flex-shrink:0}
    .ad-quote-text{font-size:13px;font-style:italic;color:var(--light);line-height:1.6;margin-bottom:10px;max-width:320px;opacity:.8}
    .ad-quote-auth{font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--yellow)}
    @media(max-width:700px){.ad-bottom{grid-template-columns:1fr}.ad-aside{text-align:left}.ad-title{font-size:clamp(52px,13vw,90px)}}

    /* ════════════════════════════════
       STIL E — EDITORIAL SPLIT
    ════════════════════════════════ */
    .ae{overflow:hidden;border-top:1px solid var(--dark-3)}
    .ae-grid{display:grid;grid-template-columns:1fr 1fr;min-height:680px}
    .ae-img{position:relative;overflow:hidden}
    .ae-img img{width:100%;height:100%;object-fit:cover;object-position:top center;display:block;filter:brightness(.8) saturate(.85);transition:filter .6s}
    .ae:hover .ae-img img{filter:brightness(.9) saturate(.95)}
    /* Thin yellow left bar */
    .ae-img::after{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:var(--yellow)}
    /* Vertical caption */
    .ae-img-label{position:absolute;bottom:32px;left:24px;font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--cream);opacity:.4}
    .ae-content{display:flex;flex-direction:column;justify-content:center;padding:80px 72px 80px 64px;background:var(--dark-2);position:relative;overflow:hidden}
    /* Ghost text background */
    .ae-content::before{content:'15+';position:absolute;font-family:var(--font-display);font-size:280px;font-weight:900;color:#fff;opacity:.025;bottom:-40px;right:-20px;line-height:1;letter-spacing:-.04em;user-select:none;pointer-events:none}
    .ae-eyebrow{font-size:10px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--yellow);margin-bottom:18px}
    .ae-title{font-family:var(--font-display);font-size:clamp(36px,4.5vw,62px);font-weight:900;text-transform:uppercase;line-height:.88;color:var(--white);margin-bottom:24px;letter-spacing:-.01em}
    .ae-title em{font-style:normal;color:var(--yellow)}
    .ae-desc{font-size:14px;font-weight:300;color:var(--light);line-height:1.75;margin-bottom:40px;max-width:none;position:relative}
    .ae-stats{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-bottom:44px;position:relative;border:1px solid var(--dark-3)}
    .ae-stat{padding:24px 28px;border-right:1px solid var(--dark-3);border-bottom:1px solid var(--dark-3)}
    .ae-stat:nth-child(2){border-right:none}
    .ae-stat:nth-child(3){border-bottom:none}
    .ae-stat:nth-child(4){border-right:none;border-bottom:none}
    .ae-stat-num{font-family:var(--font-display);font-size:clamp(40px,4vw,56px);font-weight:900;color:var(--yellow);line-height:.9;margin-bottom:8px;letter-spacing:-.02em}
    .ae-stat-lbl{font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--mid)}
    .ae-cta{display:inline-flex;align-items:center;gap:10px;background:var(--yellow);color:var(--dark);font-family:var(--font-body);font-weight:800;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:16px 28px 12px;text-decoration:none;align-self:flex-start;clip-path:polygon(0 8px,50% 0,100% 8px,100% 100%,0 100%);transition:background .2s,clip-path .3s cubic-bezier(.34,1.56,.64,1)}
    .ae-cta:hover{background:#ffff33;clip-path:polygon(0 16px,50% 0,100% 16px,100% 100%,0 100%)}
    @media(max-width:768px){.ae-grid{grid-template-columns:1fr}.ae-img{min-height:320px}.ae-content{padding:56px 40px}.ae-content::before{display:none}}

    /* ── GALLERY ── */
    .gallery-section{padding:88px 0;border-top:1px solid var(--dark-3)}
    .gallery-header{margin-bottom:44px}
    .gallery-grid{columns:3;column-gap:6px}
    .gallery-item{break-inside:avoid;margin-bottom:6px;position:relative;overflow:hidden;cursor:pointer;display:block}
    .gallery-item img{width:100%;height:auto;display:block;transition:transform .5s ease;filter:brightness(.88) saturate(.85)}
    .gallery-item:hover img{transform:scale(1.04);filter:brightness(1) saturate(1)}
    .gallery-item-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(17,17,16,.8) 0%,transparent 55%);opacity:0;transition:opacity .35s ease;display:flex;align-items:flex-end;padding:14px}
    .gallery-item:hover .gallery-item-overlay{opacity:1}
    .gallery-item-num{font-family:var(--font-display);font-size:30px;font-weight:900;color:var(--yellow);line-height:1}
    @media(max-width:768px){.gallery-grid{columns:2}}
    @media(max-width:480px){.gallery-grid{columns:1}}

    /* ── FEATURED PAIR ── */
    .featured-pair{display:grid;grid-template-columns:1.5fr 1fr;gap:6px;margin-top:52px}
    .featured-pair-item{position:relative;overflow:hidden;cursor:pointer}
    .featured-pair-item img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease;filter:brightness(.88) saturate(.85)}
    .featured-pair-item:hover img{transform:scale(1.03);filter:brightness(.98) saturate(1)}
    .featured-caption{position:absolute;bottom:0;left:0;right:0;padding:36px 24px 20px;background:linear-gradient(to top,rgba(17,17,16,.9) 0%,transparent 100%)}
    .featured-caption-label{font-size:9px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--yellow);margin-bottom:4px}
    .featured-caption-text{font-family:var(--font-display);font-size:20px;font-weight:700;text-transform:uppercase;color:var(--white);max-width:none}
    @media(max-width:640px){.featured-pair{grid-template-columns:1fr}}

    /* ── NOTES ── */
    .notes-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-top:40px;border:1px solid var(--dark-3)}
    .note-card{padding:28px 32px;background:var(--dark-2)}
    .note-card.y{background:rgba(255,254,0,.04)}
    .note-title{font-family:var(--font-display);font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--white);margin-bottom:8px}
    .note-text{font-size:13px;line-height:1.6;color:var(--mid);max-width:none}
    @media(max-width:600px){.notes-grid{grid-template-columns:1fr}}

    /* ── LIGHTBOX ── */
    .lightbox{position:fixed;inset:0;z-index:1000;background:rgba(11,11,10,.97);display:none;align-items:center;justify-content:center;padding:24px}
    .lightbox.open{display:flex}
    .lightbox-img{max-width:90vw;max-height:90vh;object-fit:contain;display:block}
    .lightbox-close{position:absolute;top:24px;right:24px;width:44px;height:44px;background:var(--dark-3);border:1px solid var(--dark-4);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--cream);font-size:18px;line-height:1}
    .lightbox-nav{position:absolute;top:50%;transform:translateY(-50%);background:var(--dark-3);border:1px solid var(--dark-4);color:var(--cream);width:44px;height:44px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:20px;transition:background .15s}
    .lightbox-nav:hover{background:var(--dark-4)}
    .lightbox-prev{left:24px}
    .lightbox-next{right:24px}
    .lightbox-counter{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);font-size:10px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--mid)}

    /* ── FOOTER ── */
    footer{padding:40px 0;background:var(--dark-2);border-top:1px solid var(--dark-3)}
    .footer-inner{max-width:960px;margin:0 auto;padding:0 40px;display:flex;justify-content:space-between;align-items:center}
    .footer-text{font-size:11px;color:var(--mid)}
    .footer-note{font-size:10px;color:var(--dark-4);text-align:right}

    /* ── SCROLL ENTRANCE ── */
    .reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease}
    .reveal.in{opacity:1;transform:none}

    /* ════════════════════════════════
       STIL F — HELL · STATS-LEISTE
    ════════════════════════════════ */
    .af{background:#f5f2eb}
    .af-grid{display:grid;grid-template-columns:1fr 400px;align-items:stretch;max-width:960px;margin:0 auto;padding:0 40px}
    .af-text{padding:80px 64px 72px 0;display:flex;flex-direction:column;justify-content:center}
    .af-eyebrow{font-size:10px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:#888880;margin-bottom:20px}
    .af-title{font-family:var(--font-display);font-size:clamp(52px,7vw,88px);font-weight:900;text-transform:uppercase;line-height:.88;letter-spacing:-.01em;color:#111110;margin-bottom:28px}
    .af-title em{font-style:normal;color:#111110;-webkit-text-stroke:2px #111110;/* outline for the em word */}
    .af-desc{font-size:15px;line-height:1.75;color:#555550;margin-bottom:36px;max-width:none;font-weight:400}
    .af-cta{display:inline-flex;align-items:center;gap:10px;background:#111110;color:#f5f2eb;font-family:var(--font-body);font-weight:800;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:16px 28px 12px;text-decoration:none;clip-path:polygon(0 8px,50% 0,100% 8px,100% 100%,0 100%);transition:background .2s,clip-path .3s cubic-bezier(.34,1.56,.64,1)}
    .af-cta:hover{background:#333330;clip-path:polygon(0 16px,50% 0,100% 16px,100% 100%,0 100%)}
    .af-portrait{overflow:hidden;min-height:540px;position:relative}
    .af-portrait img{width:100%;height:100%;object-fit:cover;object-position:top center;display:block;filter:brightness(.92) saturate(.8)}
    /* Yellow corner accent top-left */
    .af-portrait::before{content:'';position:absolute;top:0;left:0;width:100%;height:4px;background:var(--yellow);z-index:2}
    /* Stats strip — inverted: yellow background */
    .af-stats{max-width:960px;margin:0 auto;padding:0 40px;display:grid;grid-template-columns:1fr 1fr 1fr;background:var(--yellow)}
    .af-stat{padding:32px 0;border-right:1px solid rgba(0,0,0,.1);padding-right:40px;padding-left:0}
    .af-stat+.af-stat{padding-left:40px}
    .af-stat:last-child{border-right:none}
    .af-stat-num{font-family:var(--font-display);font-size:clamp(52px,7vw,76px);font-weight:900;color:#111110;line-height:.9;margin-bottom:10px;letter-spacing:-.02em}
    .af-stat-lbl{font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:rgba(0,0,0,.5)}
    @media(max-width:760px){.af-grid{grid-template-columns:1fr}.af-portrait{min-height:300px}.af-text{padding:60px 0 40px}.af-stats{grid-template-columns:1fr 1fr}.af-stat:nth-child(2){border-right:none}.af-stat:last-child{grid-column:1/-1;border-right:none}}

    /* ════════════════════════════════
       STIL G — WEISS · EDITORIAL CLEAN
    ════════════════════════════════ */
    .ag{overflow:hidden;border-top:1px solid #e8e4d8}
    .ag-grid{display:grid;grid-template-columns:1fr 1fr;min-height:680px}
    .ag-img{position:relative;overflow:hidden;background:#111110}
    .ag-img img{width:100%;height:100%;object-fit:cover;object-position:top center;display:block;filter:brightness(.9) saturate(.75);mix-blend-mode:multiply}
    /* Thick yellow top border */
    .ag-img::before{content:'';position:absolute;top:0;left:0;right:0;height:5px;background:var(--yellow);z-index:2}
    .ag-img-label{position:absolute;bottom:24px;left:24px;font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:#fff;opacity:.5;z-index:2}
    .ag-content{display:flex;flex-direction:column;justify-content:center;padding:72px 64px 72px 64px;background:#ffffff;border-left:1px solid #e8e4d8;position:relative;overflow:hidden}
    /* Very subtle ghost text */
    .ag-content::before{content:'L';position:absolute;font-family:var(--font-display);font-size:420px;font-weight:900;color:#111110;opacity:.025;bottom:-80px;right:-40px;line-height:1;letter-spacing:-.04em;user-select:none;pointer-events:none}
    .ag-eyebrow{font-size:10px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:#aaa89e;margin-bottom:18px}
    .ag-title{font-family:var(--font-display);font-size:clamp(36px,4.5vw,62px);font-weight:900;text-transform:uppercase;line-height:.88;color:#111110;margin-bottom:24px;letter-spacing:-.01em}
    .ag-title em{font-style:normal;color:#111110}
    /* Yellow underline on "em" word */
    .ag-title em::after{content:'';display:block;height:4px;background:var(--yellow);margin-top:4px;width:100%}
    .ag-desc{font-size:14px;font-weight:400;color:#555550;line-height:1.8;margin-bottom:36px;max-width:none}
    .ag-divider{width:32px;height:3px;background:var(--yellow);margin-bottom:28px}
    .ag-stats{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-bottom:40px;border:1px solid #e8e4d8}
    .ag-stat{padding:20px 24px;border-right:1px solid #e8e4d8;border-bottom:1px solid #e8e4d8}
    .ag-stat:nth-child(2){border-right:none}
    .ag-stat:nth-child(3){border-bottom:none}
    .ag-stat:nth-child(4){border-right:none;border-bottom:none}
    .ag-stat-num{font-family:var(--font-display);font-size:clamp(36px,4vw,52px);font-weight:900;color:#111110;line-height:.9;margin-bottom:8px;letter-spacing:-.02em}
    .ag-stat-num em{font-style:normal;color:var(--yellow);-webkit-text-stroke:1px #888}
    .ag-stat-lbl{font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#aaa89e}
    .ag-cta{display:inline-flex;align-items:center;gap:10px;background:var(--yellow);color:#111110;font-family:var(--font-body);font-weight:800;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:16px 28px 12px;text-decoration:none;align-self:flex-start;clip-path:polygon(0 8px,50% 0,100% 8px,100% 100%,0 100%);transition:background .2s,clip-path .3s cubic-bezier(.34,1.56,.64,1)}
    .ag-cta:hover{background:#ffff33;clip-path:polygon(0 16px,50% 0,100% 16px,100% 100%,0 100%)}
    @media(max-width:768px){.ag-grid{grid-template-columns:1fr}.ag-img{min-height:320px}.ag-content{padding:52px 40px}.ag-content::before{display:none}}
  </style>
</head>
<body>

