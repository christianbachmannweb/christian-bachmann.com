        <div class="vs-strip-inner">
          <div class="vs-id"><strong>G</strong> Weiß · Editorial · Stats-Raster · Gelbe Akzente</div>
          <div class="vs-meta">
            <span class="vs-code">background: #ffffff</span>
            <span class="vs-badge a">Hell</span>
          </div>
        </div>
      </div>
      <section class="ag">
        <div class="ag-grid">
          <div class="ag-img">
            <Image src={p06} alt="Lukas Schulze" format="avif" quality={80} width={960} />
            <div class="ag-img-label">Lukas Schulze · Heiningen</div>
          </div>
          <div class="ag-content reveal">
            <div class="ag-eyebrow">Zimmerei · Heiningen</div>
