---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Fragebogen – Holzbau Schulze</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@300;400;500;600;700;800;900&family=Big+Shoulders+Display:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --yellow: #fffe00;
      --yellow-dim: rgba(255, 254, 0, 0.12);
      --dark: #111110;
      --dark-2: #1c1c1a;
      --dark-3: #2a2a27;
      --dark-4: #3a3a36;
      --mid: #6b6b64;
      --light: #c8c8bc;
      --cream: #f0ede4;
      --white: #ffffff;
      --font-display: 'Big Shoulders Display', sans-serif;
      --font-body: 'Libre Franklin', sans-serif;
    }

    body {
      background: var(--dark);
      color: var(--cream);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      overflow-x: clip;
    }

    /* ── GATE ── */
    #gate {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: #0f0f0e;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: var(--font-body);
      padding: 32px;
    }
    #gate.hidden { display: none; }
    .gate-dot { width: 8px; height: 8px; background: var(--yellow); border-radius: 50%; margin-bottom: 40px; }
    .gate-title { font-size: 13px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--mid); margin-bottom: 32px; }
    .gate-form { display: flex; flex-direction: column; gap: 12px; width: 100%; max-width: 280px; }
    .gate-input { background: var(--dark-2); border: 1px solid var(--dark-3); color: var(--cream); font-family: var(--font-body); font-size: 15px; padding: 14px 16px; outline: none; transition: border-color 0.2s; }
    .gate-input:focus { border-color: var(--yellow); }
    .gate-input::placeholder { color: var(--dark-4); }
    .gate-btn { background: var(--yellow); color: #111110; font-family: var(--font-body); font-weight: 700; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; padding: 14px; border: none; cursor: pointer; }
    .gate-error { font-size: 12px; color: rgba(255,80,80,0.8); text-align: center; display: none; }
    .gate-error.visible { display: block; }

    /* ── PROGRESS BAR ── */
    #progress-bar {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      background: var(--yellow);
      transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 200;
    }

    /* ── HEADER ── */
    header {
      background: var(--dark-2);
      border-bottom: 1px solid var(--dark-3);
      padding: 16px 0;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 960px;
      margin: 0 auto;
      padding: 0 32px;
      gap: 24px;
    }
    .logo-img { height: 32px; width: auto; display: block; }
    .header-nav { display: flex; align-items: center; gap: 4px; }
    .header-nav a { font-family: var(--font-body); font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mid); text-decoration: none; padding: 6px 14px; border: 1px solid transparent; transition: color 0.15s, border-color 0.15s; }
    .header-nav a:hover { color: var(--cream); }
    .header-nav a.active { color: var(--yellow); border-color: rgba(255,254,0,0.25); }
    .hamburger { display: none; flex-direction: column; justify-content: center; gap: 5px; width: 36px; height: 36px; background: none; border: none; cursor: pointer; padding: 4px; flex-shrink: 0; }
    .hamburger span { display: block; height: 2px; background: var(--cream); transition: transform 0.25s ease, opacity 0.2s ease, width 0.2s ease; transform-origin: center; }
    .hamburger span:nth-child(2) { width: 70%; }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; width: 100%; }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .mobile-nav { display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--dark-2); border-bottom: 3px solid var(--yellow); padding: 8px 0 16px; z-index: 99; }
    .mobile-nav.open { display: block; }
    .mobile-nav a { display: block; font-family: var(--font-body); font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mid); text-decoration: none; padding: 14px 32px; border-bottom: 1px solid var(--dark-3); transition: color 0.15s, background 0.15s; }
    .mobile-nav a:last-child { border-bottom: none; }
    .mobile-nav a:hover { color: var(--cream); background: var(--dark-3); }
    .mobile-nav a.active { color: var(--yellow); }
    @media (max-width: 640px) {
      .header-nav { display: none; }
      .hamburger { display: flex; }
    }

    /* ── SLIDES ── */
    #slides-wrapper {
      min-height: calc(100dvh - 65px);
      display: flex;
      flex-direction: column;
    }

    .slide {
      display: none;
      flex-direction: column;
      flex: 1;
      padding: 52px 32px 48px;
      max-width: 680px;
      margin: 0 auto;
      width: 100%;
      animation: fadeUp 0.3s ease;
    }
    .slide.active { display: flex; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .slide-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 36px;
    }
    .slide-category {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--yellow);
    }
    .slide-counter {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--dark-4);
    }

    .slide-question {
      font-family: var(--font-display);
      font-size: clamp(22px, 3.5vw, 36px);
      font-weight: 700;
      text-transform: uppercase;
      line-height: 1.1;
      letter-spacing: 0.01em;
      color: var(--white);
      margin-bottom: 36px;
    }

    /* ── INPUTS ── */
    .q-textarea {
      width: 100%;
      min-height: 148px;
      background: var(--dark-2);
      border: 1px solid var(--dark-3);
      color: var(--cream);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      padding: 16px 18px;
      outline: none;
      resize: vertical;
      transition: border-color 0.2s;
    }
    .q-textarea:focus { border-color: var(--yellow); }
    .q-textarea::placeholder { color: var(--dark-4); }

    /* ── OPTIONS (radio / checkbox) ── */
    .options { display: flex; flex-direction: column; gap: 8px; }

    .option-label {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 15px 18px;
      background: var(--dark-2);
      border: 1px solid var(--dark-3);
      cursor: pointer;
      transition: border-color 0.15s, background 0.15s;
      user-select: none;
    }
    .option-label:hover { border-color: var(--dark-4); background: #1f1f1d; }
    .option-label.selected { border-color: var(--yellow); background: var(--yellow-dim); }
    .option-label input { position: absolute; opacity: 0; width: 0; height: 0; }

    .option-marker {
      width: 18px;
      height: 18px;
      border: 2px solid var(--dark-4);
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.15s, background 0.15s;
    }
    .option-marker.round { border-radius: 50%; }
    .option-label.selected .option-marker { border-color: var(--yellow); background: var(--yellow); }
    .option-marker-inner {
      width: 7px;
      height: 7px;
      background: var(--dark);
      border-radius: 50%;
      display: none;
    }
    .option-marker.round .option-marker-inner { display: block; opacity: 0; transition: opacity 0.15s; }
    .option-label.selected .option-marker.round .option-marker-inner { opacity: 1; }
    /* checkbox checkmark */
    .option-marker.square::after {
      content: '';
      width: 10px;
      height: 6px;
      border-left: 2px solid var(--dark);
      border-bottom: 2px solid var(--dark);
      transform: rotate(-45deg) translateY(-1px);
      display: none;
    }
    .option-label.selected .option-marker.square::after { display: block; }

    .option-text { font-size: 15px; color: var(--light); transition: color 0.15s; }
    .option-label.selected .option-text { color: var(--cream); }

    /* ── NAVIGATION ── */
    .slide-nav {
      margin-top: auto;
      padding-top: 40px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .btn-back {
      background: transparent;
      color: var(--mid);
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 13px 20px;
      border: 1px solid var(--dark-3);
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s;
    }
    .btn-back:hover { color: var(--cream); border-color: var(--dark-4); }
    .btn-back:disabled { opacity: 0.3; cursor: default; }

    .btn-next {
      background: var(--yellow);
      color: var(--dark);
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 22px 32px 14px;
      border: none;
      cursor: pointer;
      clip-path: polygon(0 10px, 50% 0, 100% 10px, 100% 100%, 0 100%);
      transition: clip-path 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s;
    }
    .btn-next:hover {
      clip-path: polygon(0 22px, 50% 0, 100% 22px, 100% 100%, 0 100%);
      background: #ffff33;
    }

    .save-status {
      margin-left: auto;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--mid);
      opacity: 0;
      transition: opacity 0.4s;
    }
    .save-status.visible { opacity: 1; }
    .save-status.saving { color: var(--mid); }
    .save-status.saved { color: var(--yellow); }
    .save-status.error { color: rgba(255,80,80,0.7); }

    /* ── SKIP HINT ── */
    .skip-hint {
      margin-top: 12px;
      font-size: 12px;
      color: var(--dark-4);
    }

    /* ── THANK YOU ── */
    #thankyou {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: calc(100dvh - 65px);
      padding: 60px 32px;
      text-align: center;
    }
    #thankyou.active { display: flex; }
    .ty-dot { width: 10px; height: 10px; background: var(--yellow); border-radius: 50%; margin-bottom: 40px; }
    .ty-title {
      font-family: var(--font-display);
      font-size: clamp(40px, 7vw, 72px);
      font-weight: 800;
      text-transform: uppercase;
      color: var(--white);
      margin-bottom: 20px;
      line-height: 1;
    }
    .ty-title em { font-style: normal; color: var(--yellow); }
    .ty-sub { font-size: 17px; color: var(--light); max-width: 420px; line-height: 1.7; margin-bottom: 40px; }
    .ty-meta { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dark-4); }
    .btn-restart {
      margin-top: 40px;
      background: transparent;
      color: var(--mid);
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 13px 20px;
      border: 1px solid var(--dark-3);
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s;
    }
    .btn-restart:hover { color: var(--cream); border-color: var(--dark-4); }

    /* ── RESUME BANNER ── */
    #resume-banner {
      display: none;
      background: var(--yellow-dim);
      border-bottom: 1px solid rgba(255,254,0,0.15);
      padding: 12px 32px;
      text-align: center;
    }
    #resume-banner.visible { display: block; }
    #resume-banner span {
      font-size: 13px;
      color: var(--light);
    }
    #resume-banner strong { color: var(--yellow); }
    #resume-from { background: none; border: none; color: var(--yellow); font-family: var(--font-body); font-size: 13px; font-weight: 700; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; margin-left: 8px; }

    @media (max-width: 480px) {
      .slide { padding: 40px 20px 40px; }
      .btn-next { padding: 20px 24px 12px; }
    }
  </style>
</head>
<body>

  <div id="progress-bar" style="width:0%"></div>

  <!-- GATE -->
  <div id="gate">
    <div class="gate-dot"></div>
    <div class="gate-title">Holzbau Schulze · Fragebogen</div>
    <form class="gate-form" id="gate-form">
      <input class="gate-input" type="password" id="pw-input" placeholder="Passwort" autocomplete="current-password" />
      <button class="gate-btn" type="submit">Zugang</button>
      <div class="gate-error" id="gate-error">Falsches Passwort</div>
    </form>
  </div>

  <!-- CONTENT -->
  <div id="content" style="display:none">

    <header style="position:sticky;top:0;z-index:100;">
      <div class="header-inner">
        <img class="logo-img" src="/assets/holzbau-schulze-logo.png" alt="Holzbau Schulze" />
        <nav class="header-nav">
          <a href="/holzbau-schulze">Styleguide</a>
          <a href="/holzbau-schulze/zielgruppe">Zielgruppe</a>
          <a href="/holzbau-schulze/strategie">SEO & AEO</a>
          <a href="/holzbau-schulze/bilder">Bilder</a>
          <a href="/holzbau-schulze/fragebogen" class="active">Fragebogen</a>
        </nav>
        <button class="hamburger" id="hamburger" aria-label="Menü">
          <span></span><span></span><span></span>
        </button>
      </div>
      <nav class="mobile-nav" id="mobile-nav">
        <a href="/holzbau-schulze">Styleguide</a>
        <a href="/holzbau-schulze/zielgruppe">Zielgruppe</a>
        <a href="/holzbau-schulze/strategie">SEO & AEO</a>
        <a href="/holzbau-schulze/bilder">Bilder</a>
        <a href="/holzbau-schulze/fragebogen" class="active">Fragebogen</a>
      </nav>
    </header>

    <div id="resume-banner">
      <span>Du warst schon bei Frage <strong id="resume-num"></strong>. </span>
      <button id="resume-from">Da weitermachen →</button>
    </div>

    <div id="slides-wrapper">
      <div id="slides-inner"></div>
      <div id="thankyou">
        <div class="ty-dot"></div>
        <div class="ty-title">Danke,<br><em>Lukas.</em></div>
        <p class="ty-sub">Ich habe alle deine Antworten erhalten und melde mich sobald ich alles durchgearbeitet habe.</p>
        <div class="ty-meta">Alle 33 Fragen beantwortet · Gespeichert</div>
        <button class="btn-restart" id="btn-restart">Antworten nochmal ansehen</button>
      </div>
    </div>

  </div>

  <script>
    // ── CONFIG ──
    const WEBHOOK_URL = 'https://n8n.polizen.app/webhook/schulze';
    const SESSION_ID  = 'lukas-schulze-2026';
    const STORAGE_KEY = 'hs_fragebogen_v1';

    // ── QUESTIONS ──
    const questions = [
      // Kapitel 1 · Du als Person
      {
        id: 'name_format', category: 'Du als Person', type: 'radio',
        text: 'Wie soll dein Name auf der Webseite stehen?',
        options: ['Lukas Schulze', 'Lukas', 'Holzbau Schulze', 'Zimmerei Schulze']
      },
      {
        id: 'bauernhaus', category: 'Du als Person', type: 'radio',
        text: 'Dein Text über das Bauernhaus und deine Handwerkerfamilie ist stark. Darf das auf die Webseite?',
        options: ['Ja, genau so', 'Ja, aber kürzer', 'Lieber nur einen Teil davon', 'Nein, lieber weglassen']
      },
      {
        id: 'frau', category: 'Du als Person', type: 'radio',
        text: 'Darf deine Frau auf der Webseite vorkommen?',
        options: ['Ja, gerne mit Namen', 'Ja, aber anonym (\"meine Frau\")', 'Lieber nicht']
      },
      {
        id: 'foto_portrait', category: 'Du als Person', type: 'radio',
        text: 'Hast du ein Foto von dir womit du zufrieden bist?',
        options: ['Ja, habe ich', 'Das freigestellte Portrait passt', 'Nein, muss noch gemacht werden', 'Ich mag keine Fotos von mir']
      },

      // Kapitel 2 · Design & Stil
      {
        id: 'website_beispiel', category: 'Design & Stil', type: 'textarea',
        text: 'Gibt es eine Webseite die dir vom Gefühl her gefällt? URL oder kurze Beschreibung genügt.',
        placeholder: 'z.B. „Die Seite von ... ist schön weil ..." oder eine URL'
      },
      {
        id: 'konzeptseite_feedback', category: 'Design & Stil', type: 'textarea',
        text: 'Was gefällt dir an der aktuellen Konzeptseite? Was stört dich oder wirkt falsch?',
        placeholder: 'Ehrlich — alles was du sagst hilft mir die echte Seite besser zu machen'
      },
      {
        id: 'hell_dunkel', category: 'Design & Stil', type: 'radio',
        text: 'Hell oder dunkel — hast du eine klare Präferenz?',
        options: ['Dunkel (wie die Konzeptseite)', 'Hell / natürlich wie Holz', 'Gemischt — beides', 'Egal, du entscheidest']
      },
      {
        id: 'bilder_anzahl', category: 'Design & Stil', type: 'radio',
        text: 'Wie viele eigene Baustellen-Fotos hast du ungefähr — Handy-Fotos zählen?',
        options: ['Wenige (unter 10)', 'Einige (10–30)', 'Viele (über 30)', 'Kaum welche']
      },

      // Kapitel 3 · Leistungen
      {
        id: 'hauptgeschaeft', category: 'Leistungen', type: 'checkbox',
        text: 'Was ist dein Hauptgeschäft? Alles auswählen womit du den Großteil verdienst.',
        options: ['Dachsanierung / Neudeckung', 'Dachdämmung', 'Dachfenster', 'Holzfassade', 'Carport / Pergola / Terrassendach', 'Neubau / Dachstuhl', 'Innenausbau', 'Aufstockung / Anbau']
      },
      {
        id: 'lieblingsleistung', category: 'Leistungen', type: 'textarea',
        text: 'Welche Leistung machst du am liebsten — bei der du sagst: „Da bin ich wirklich gut"?',
        placeholder: 'Nicht was du am häufigsten machst, sondern was dir am meisten liegt'
      },
      {
        id: 'nicht_machen', category: 'Leistungen', type: 'textarea',
        text: 'Was machst du bewusst NICHT? Welche Anfragen lehnst du regelmäßig ab?',
        placeholder: 'Das hilft um falsche Erwartungen gar nicht erst zu wecken'
      },
      {
        id: 'einzugsgebiet', category: 'Leistungen', type: 'radio',
        text: 'Wie weit fährst du für Aufträge?',
        options: ['Nur Heiningen / direkte Umgebung', 'Landkreis Göppingen', 'Ganz Baden-Württemberg', 'Kommt auf den Auftrag an']
      },

      // Kapitel 4 · Referenzen
      {
        id: 'projekte_stolz', category: 'Referenzen', type: 'textarea',
        text: 'Beschreib 1–3 Projekte auf die du besonders stolz bist. Was war das, und wo lag es?',
        placeholder: 'z.B. „Dachsanierung in Göppingen, komplett neu gedeckt inkl. Dämmung, der Kunde ..." '
      },
      {
        id: 'google_bewertungen', category: 'Referenzen', type: 'radio',
        text: 'Darf ich deine Google-Bewertungen auf der Webseite verwenden?',
        options: ['Ja, alle', 'Ja, aber ohne vollständige Namen', 'Erst die Kunden fragen', 'Lieber nicht']
      },
      {
        id: 'projekt_dokumentation', category: 'Referenzen', type: 'radio',
        text: 'Gibt es laufende oder kommende Projekte die du fotografisch dokumentieren könntest?',
        options: ['Ja, aktuell läuft was Passendes', 'In ein paar Wochen', 'Nicht wirklich', 'Weiß ich noch nicht']
      },

      // Kapitel 5 · Fotos & Videos
      {
        id: 'drohne', category: 'Fotos & Videos', type: 'radio',
        text: 'Hast du eine Drohne oder kennst du jemanden der für dich fliegen könnte?',
        options: ['Ja, ich habe selbst eine', 'Ich kenne jemanden', 'Nein, müssten wir organisieren', 'Kein Interesse an Drohnenfotos']
      },
      {
        id: 'drohnen_objekt', category: 'Fotos & Videos', type: 'textarea',
        text: 'Gibt es ein fertiges Dach oder eine Holzfassade die sich für Drohnenfotos eignen würde?',
        placeholder: 'Ort, Beschreibung des Projekts — muss nicht perfekt sein'
      },

      // Kapitel 6 · Kontakt & Anfragen
      {
        id: 'kontaktweg', category: 'Kontakt & Anfragen', type: 'checkbox',
        text: 'Wie sollen Kunden am liebsten Kontakt aufnehmen? Alles auswählen was dir recht ist.',
        options: ['Anruf', 'WhatsApp', 'E-Mail', 'Kontaktformular auf der Webseite']
      },
      {
        id: 'erstinfo_von_kunden', category: 'Kontakt & Anfragen', type: 'textarea',
        text: 'Was brauchst du von einem Kunden um ein sinnvolles Erstgespräch führen zu können?',
        placeholder: 'Was fragen Kunden als erstes, was fragst du als erstes zurück?'
      },
      {
        id: 'antwortzeit', category: 'Kontakt & Anfragen', type: 'radio',
        text: 'Wie schnell antwortest du typischerweise auf Anfragen?',
        options: ['Innerhalb von 24 Stunden', 'Innerhalb eines Werktages', 'Am gleichen Tag wenn möglich', 'Kann ich nicht wirklich versprechen']
      },

      // Kapitel 7 · Webseite konkret
      {
        id: 'preise_zeigen', category: 'Webseite konkret', type: 'radio',
        text: 'Willst du Preise oder Preisspannen auf der Webseite zeigen?',
        options: ['Ja, gerne transparent', 'Nur Richtwerte / ab-Preise', 'Nein, nur auf Anfrage', 'Noch nicht sicher']
      },
      {
        id: 'ratgeber_bereich', category: 'Webseite konkret', type: 'radio',
        text: 'Soll es einen Ratgeber-Bereich geben? (z.B. „Wann lohnt sich eine Aufdachdämmung?")',
        options: ['Ja, das macht Sinn', 'Vielleicht später', 'Nein, zu viel Aufwand', 'Was ist das genau?']
      },
      {
        id: 'social_media', category: 'Webseite konkret', type: 'checkbox',
        text: 'Hast du Social Media? Was soll auf der Webseite verlinkt werden?',
        options: ['Instagram', 'Facebook', 'YouTube', 'Kein Social Media']
      },
      {
        id: 'mitarbeiter_gesucht', category: 'Webseite konkret', type: 'radio',
        text: 'Suchst du aktuell oder in Zukunft Mitarbeiter — soll das auf die Webseite?',
        options: ['Ja, aktuell auf der Suche', 'Vielleicht in Zukunft', 'Nein']
      },
      {
        id: 'impressum_steuer', category: 'Webseite konkret', type: 'radio',
        text: 'Hast du eine Umsatzsteuer-ID? (Pflichtangabe im Impressum)',
        options: ['Ja, habe ich', 'Nein, ich bin Kleinunternehmer', 'Weiß ich nicht genau']
      },
      {
        id: 'oeffnungszeiten', category: 'Webseite konkret', type: 'radio',
        text: 'Gibt es Öffnungszeiten oder feste Erreichbarkeitszeiten die du angeben willst?',
        options: ['Ja, feste Zeiten', 'Ich bin flexibel erreichbar', 'Lieber keine Zeiten angeben']
      },

      // Kapitel 8 · Konkurrenz & Positionierung
      {
        id: 'unterschied_konkurrenz', category: 'Positionierung', type: 'textarea',
        text: 'Was unterscheidet dich von anderen Zimmerern in der Region — in deinen eigenen Worten?',
        placeholder: 'Nicht was du glaubst sagen zu sollen, sondern was Kunden dir wirklich sagen'
      },
      {
        id: 'mitbewerber_website', category: 'Positionierung', type: 'textarea',
        text: 'Gibt es eine Mitbewerber-Webseite die du gut oder besonders schlecht findest? Warum?',
        placeholder: 'Optional — hilft mir zu verstehen was du dir NICHT vorstellst'
      },

      // Kapitel 9 · Praktisches
      {
        id: 'logo_datei', category: 'Praktisches', type: 'radio',
        text: 'Hast du das Logo als Datei — SVG oder hochauflösendes PNG?',
        options: ['Ja, als SVG', 'Ja, als PNG', 'Nur auf dem Fahrzeug / Visitenkarte', 'Nein, Logo muss noch erstellt werden']
      },
      {
        id: 'bestehende_materialien', category: 'Praktisches', type: 'radio',
        text: 'Gibt es schon Texte, Flyer oder Broschüren über Holzbau Schulze?',
        options: ['Ja, habe ich', 'Nur Visitenkarte', 'Nur den Text den ich dir geschickt habe', 'Nein, noch nichts']
      },
      {
        id: 'tabu', category: 'Praktisches', type: 'textarea',
        text: 'Was soll auf der Webseite auf keinen Fall stehen oder gezeigt werden?',
        placeholder: 'Preise? Bestimmte Projekte? Privates? Lieber jetzt klären als später'
      },

      // Kapitel 10 · Das große Bild
      {
        id: 'eindruck_hinterlassen', category: 'Das große Bild', type: 'textarea',
        text: 'Was soll ein Besucher denken wenn er die Seite verlässt — auch ohne anzurufen?',
        placeholder: 'Das eine Gefühl oder der eine Gedanke den du hinterlassen willst'
      },
      {
        id: 'wunschkunde', category: 'Das große Bild', type: 'textarea',
        text: 'Beschreib deinen perfekten Wunschkunden. Wer ist das, was hat er für ein Problem, warum wählt er am Ende dich?',
        placeholder: 'So konkret wie möglich — das hilft mir jeden Text auf der Webseite besser zu schreiben'
      },
    ];

    const TOTAL = questions.length;

    // ── STATE ──
    let state = { currentIndex: 0, answers: {}, completed: false };

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) state = { ...state, ...JSON.parse(raw) };
      } catch(e) {}
    }

    function saveState() {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch(e) {}
    }

    // ── WEBHOOK ──
    async function sendWebhook(status = 'progress') {
      if (!WEBHOOK_URL) return;
      try {
        showSaveStatus('saving');
        await fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            session_id: SESSION_ID,
            timestamp: new Date().toISOString(),
            status,
            progress: state.currentIndex,
            total: TOTAL,
            answers: state.answers
          })
        });
        showSaveStatus('saved');
      } catch(e) {
        showSaveStatus('error');
      }
    }

    let saveStatusTimer;
    function showSaveStatus(type) {
      const el = document.getElementById('save-status');
      if (!el) return;
      clearTimeout(saveStatusTimer);
      el.className = 'save-status visible ' + type;
      el.textContent = type === 'saving' ? 'Speichert …' : type === 'saved' ? 'Gespeichert ✓' : 'Lokale Kopie ✓';
      if (type !== 'saving') {
        saveStatusTimer = setTimeout(() => el.classList.remove('visible'), 3000);
      }
    }

    // ── RENDER ──
    function buildSlideHTML(q, i) {
      const savedAnswer = state.answers[q.id];

      let inputHTML = '';
      if (q.type === 'textarea') {
        inputHTML = `
          <textarea class="q-textarea" id="input-${i}" placeholder="${q.placeholder || ''}" rows="5">${savedAnswer || ''}</textarea>
          <p class="skip-hint">Kannst du auch überspringen und später ausfüllen.</p>`;
      } else {
        const isCheckbox = q.type === 'checkbox';
        const savedArr = Array.isArray(savedAnswer) ? savedAnswer : (savedAnswer ? [savedAnswer] : []);
        const opts = q.options.map((opt, oi) => {
          const isSelected = isCheckbox ? savedArr.includes(opt) : savedAnswer === opt;
          const markerClass = isCheckbox ? 'square' : 'round';
          return `
            <label class="option-label${isSelected ? ' selected' : ''}">
              <input type="${isCheckbox ? 'checkbox' : 'radio'}" name="q${i}" value="${opt}" ${isSelected ? 'checked' : ''} />
              <span class="option-marker ${markerClass}"><span class="option-marker-inner"></span></span>
              <span class="option-text">${opt}</span>
            </label>`;
        }).join('');
        inputHTML = `<div class="options" id="input-${i}">${opts}</div>`;
      }

      const isFirst = i === 0;
      return `
        <div class="slide-meta">
          <span class="slide-category">${q.category}</span>
          <span class="slide-counter">${i + 1} / ${TOTAL}</span>
        </div>
        <div class="slide-question">${q.text}</div>
        ${inputHTML}
        <div class="slide-nav">
          <button class="btn-back" id="back-${i}" ${isFirst ? 'disabled' : ''}>Zurück</button>
          <button class="btn-next" id="next-${i}">${i === TOTAL - 1 ? 'Abschicken' : 'Weiter'}</button>
          <span class="save-status" id="save-status"></span>
        </div>`;
    }

    function renderAllSlides() {
      const container = document.getElementById('slides-inner');
      questions.forEach((q, i) => {
        const div = document.createElement('div');
        div.className = 'slide';
        div.id = `slide-${i}`;
        div.innerHTML = buildSlideHTML(q, i);
        container.appendChild(div);
      });
      attachAllListeners();
    }

    function attachAllListeners() {
      questions.forEach((q, i) => {
        const backBtn = document.getElementById(`back-${i}`);
        const nextBtn = document.getElementById(`next-${i}`);
        if (backBtn) backBtn.addEventListener('click', () => goTo(i - 1));
        if (nextBtn) nextBtn.addEventListener('click', () => handleNext(i));

        if (q.type !== 'textarea') {
          const inputWrap = document.getElementById(`input-${i}`);
          if (!inputWrap) return;
          inputWrap.querySelectorAll('input').forEach(inp => {
            inp.addEventListener('change', () => {
              updateOptionStyles(inputWrap, q.type);
              collectAnswer(i);
              saveState();
            });
          });
        }
      });

      document.getElementById('btn-restart')?.addEventListener('click', () => {
        state.completed = false;
        saveState();
        showSlide(0);
        document.getElementById('thankyou').classList.remove('active');
      });
    }

    function updateOptionStyles(wrap, type) {
      const labels = wrap.querySelectorAll('.option-label');
      labels.forEach(label => {
        const inp = label.querySelector('input');
        label.classList.toggle('selected', inp.checked);
      });
    }

    function collectAnswer(index) {
      const q = questions[index];
      if (q.type === 'textarea') {
        const el = document.getElementById(`input-${index}`);
        state.answers[q.id] = el ? el.value : '';
      } else if (q.type === 'checkbox') {
        const wrap = document.getElementById(`input-${index}`);
        if (!wrap) return;
        state.answers[q.id] = Array.from(wrap.querySelectorAll('input:checked')).map(i => i.value);
      } else {
        const wrap = document.getElementById(`input-${index}`);
        if (!wrap) return;
        const checked = wrap.querySelector('input:checked');
        state.answers[q.id] = checked ? checked.value : '';
      }
    }

    function handleNext(index) {
      collectAnswer(index);
      saveState();
      sendWebhook(index === TOTAL - 1 ? 'complete' : 'progress');

      if (index === TOTAL - 1) {
        state.completed = true;
        saveState();
        showThankyou();
      } else {
        goTo(index + 1);
      }
    }

    function goTo(index) {
      if (index < 0 || index >= TOTAL) return;
      document.querySelectorAll('.slide').forEach(s => s.classList.remove('active'));
      const slide = document.getElementById(`slide-${index}`);
      if (slide) {
        slide.classList.remove('active');
        void slide.offsetWidth; // force reflow for animation restart
        slide.classList.add('active');
        state.currentIndex = index;
        saveState();
        updateProgress();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function showSlide(index) {
      document.getElementById('thankyou').classList.remove('active');
      document.querySelectorAll('.slide').forEach(s => s.classList.remove('active'));
      const slide = document.getElementById(`slide-${index}`);
      if (slide) {
        slide.classList.add('active');
        state.currentIndex = index;
        updateProgress();
      }
    }

    function showThankyou() {
      document.querySelectorAll('.slide').forEach(s => s.classList.remove('active'));
      document.getElementById('thankyou').classList.add('active');
      document.getElementById('progress-bar').style.width = '100%';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updateProgress() {
      const pct = (state.currentIndex / TOTAL) * 100;
      document.getElementById('progress-bar').style.width = pct + '%';
    }

    // ── RESUME BANNER ──
    function showResumeBanner() {
      const idx = state.currentIndex;
      if (idx <= 0) return;
      const banner = document.getElementById('resume-banner');
      document.getElementById('resume-num').textContent = idx + 1;
      banner.classList.add('visible');
      document.getElementById('resume-from').addEventListener('click', () => {
        banner.classList.remove('visible');
        showSlide(idx);
      });
    }

    // ── GATE ──
    function initGate() {
      const gate = document.getElementById('gate');
      const content = document.getElementById('content');
      if (sessionStorage.getItem('schulze_access') === '1') {
        gate.classList.add('hidden');
        content.style.display = '';
        return;
      }
      document.getElementById('gate-form').addEventListener('submit', e => {
        e.preventDefault();
        const val = document.getElementById('pw-input').value.toLowerCase();
        if (val === 'schulze') {
          sessionStorage.setItem('schulze_access', '1');
          gate.classList.add('hidden');
          content.style.display = '';
        } else {
          document.getElementById('gate-error').classList.add('visible');
          document.getElementById('pw-input').value = '';
          document.getElementById('pw-input').focus();
        }
      });
    }

    // ── HAMBURGER ──
    function initHamburger() {
      const btn = document.getElementById('hamburger');
      const nav = document.getElementById('mobile-nav');
      btn?.addEventListener('click', () => {
        btn.classList.toggle('open');
        nav.classList.toggle('open');
      });
      nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
        btn.classList.remove('open');
        nav.classList.remove('open');
      }));
    }

    // ── BOOT ──
    initGate();
    initHamburger();
    loadState();
    renderAllSlides();

    if (state.completed) {
      showThankyou();
    } else {
      showSlide(0);
      showResumeBanner();
    }
  </script>

</body>
</html>
